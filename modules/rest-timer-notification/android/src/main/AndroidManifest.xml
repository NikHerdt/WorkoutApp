<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Fires at the rest timer's end time and swaps the live countdown
      notification for "Rest complete" in place. Runs without the app process,
      so the alert still lands if the app was swiped away.
    -->
    <receiver
      android:name=".RestTimerAlarmReceiver"
      android:enabled="true"
      android:exported="false" />
  </application>
</manifest>
