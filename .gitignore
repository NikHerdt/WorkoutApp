!.env.example

# legacy baked-in credential modules (superseded by .env)
src/config/*.local.ts

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local native module build output (the sources beside it ARE committed)
modules/*/android/build/
modules/*/android/.cxx/
modules/*/build/

# program files
The_Ultimate_Push_Pull_Legs_System_-_5x copy.xlsx